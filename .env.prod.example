# Copy to .env.prod and replace every placeholder before running docker-compose.prod.yml.

# --- Database ---
POSTGRES_DB=myhealth
POSTGRES_USER=myhealth
POSTGRES_PASSWORD=replace-with-a-long-random-password

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/myhealth
SPRING_DATASOURCE_USERNAME=myhealth
SPRING_DATASOURCE_PASSWORD=replace-with-the-same-postgres-password
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=300000
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# --- Security ---
JWT_SECRET=replace-with-at-least-32-random-bytes-base64-or-long-random-text
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
CORS_ALLOWED_ORIGINS=https://your-domain.example

# --- AI ---
AI_PROVIDER=local
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=gemma4:e4b
OLLAMA_VISION_MODEL=gemma4:e4b
AI_IDLE_TIMEOUT_SEC=60

# --- Rate limit ---
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_AI_LIMIT=20
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_TRUST_FORWARDED_FOR=true
REDIS_URL=redis://redis:6379
RATE_LIMIT_REDIS_KEY_PREFIX=myhealth:rate-limit
RATE_LIMIT_REDIS_FAIL_OPEN=false
RATE_LIMIT_REDIS_REQUEST_TIMEOUT=2s
RATE_LIMIT_REDIS_TTL_PADDING=10s

# --- Storage ---
UPLOAD_DIR=/app/uploads
