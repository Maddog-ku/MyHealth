# Docker Postgres 預設暴露在 5433（避開本機 brew Postgres 的 5432）
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/myhealth
SPRING_DATASOURCE_USERNAME=myhealth
SPRING_DATASOURCE_PASSWORD=changeme

JWT_SECRET=change-me-to-a-base64-or-long-random-secret-at-least-32-bytes
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2-vl:7b
AI_IDLE_TIMEOUT_SEC=300

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

UPLOAD_DIR=./uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
