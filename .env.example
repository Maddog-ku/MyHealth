# Docker Postgres 預設暴露在 5433（避開本機 brew Postgres 的 5432）
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/myhealth
SPRING_DATASOURCE_USERNAME=myhealth
SPRING_DATASOURCE_PASSWORD=changeme

JWT_SECRET=change-me-to-a-base64-or-long-random-secret-at-least-32-bytes
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
# 每次 chat 都會帶 keep_alive=0 → Ollama 用完即釋放，不需要等 idle timeout
OLLAMA_TEXT_MODEL=gemma4:e4b
OLLAMA_VISION_MODEL=gemma4:e4b
AI_IDLE_TIMEOUT_SEC=60

RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_REFRESH_LIMIT=30
RATE_LIMIT_AI_LIMIT=20
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_TRUST_FORWARDED_FOR=false
REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_KEY_PREFIX=myhealth:rate-limit
RATE_LIMIT_REDIS_FAIL_OPEN=false
RATE_LIMIT_REDIS_REQUEST_TIMEOUT=2s
RATE_LIMIT_REDIS_TTL_PADDING=10s

UPLOAD_DIR=./uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
